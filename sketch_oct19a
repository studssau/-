#include "compass.h"
#include "gps.h"
#include "LoRa_E220.h"

LoRa_E220 e220ttl(8, 9, 5, 7, 6);

void setup() {
  Serial.begin(9600);
  initCompass();
  initGps();
  e220ttl.begin();
  }

void loop() {
  int x, y, z;
  float sh, d;

readCompass(x, y, z);
readGps(sh, d);
  Serial.print(x);
  Serial.print(",");
  Serial.print(y); 
  Serial.print(",");
  Serial.print(z);
  Serial.print(",");
  Serial.print(sh); 
  Serial.print(",");
  Serial.print(d);
  Serial.println();

  e220ttl.sendMessage(String(x) + "," + String(y) + "," + String(z) + "," + String(sh) + "," + String(d) + "\n\r");

delay(1000);
}

f (e220ttl.available() > 1) { //Ждем больше одного байта
    
    ResponseContainer response = e220ttl.receiveMessage(); //Получение сообщения с радиомодуля
    
    String Message = response.data; //Запись в переменную Message типа String (строка)

  }
